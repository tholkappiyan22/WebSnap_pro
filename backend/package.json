{
  "name": "websnap-pro-backend",
  "version": "1.0.0",
  "description": "WebSnap Pro — Backend API for automated website screenshots",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "cross-env DATABASE_URL=\"file:./dev.db\" prisma generate",
    "db:push": "cross-env DATABASE_URL=\"file:./dev.db\" prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "apify-client": "^2.25.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "playwright": "^1.49.1",
    "prisma": "^6.9.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^3.0.4"
  }
}
